# Copy to ".env" and fill in to enable Discord login + cloud saves.
# Leave unset to run the game anonymously (local stats, JSON leaderboard).
# These are the PUBLIC keys — safe to ship in the frontend (RLS protects data).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: your live site URL, used in the shared-result text.
# Defaults to the GitHub repo if unset.
VITE_SITE_URL=https://your-domain.com
