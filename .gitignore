node_modules
dist
.DS_Store
*.local
.vite

# Local env (Supabase keys etc.) — never commit. Use .env.example as a template.
.env
.env.*
!.env.example

# Backend runtime data (leaderboard JSON store)
/server/data/

# Raw resource pack (large ~18MB). Not needed in the repo — the extracted item
# icons live in public/items/. Regenerate with scripts/import-textures.mjs.
# Textures are from the official Hypixel SkyBlock Resource Pack; see
# assets/HYPIXEL_PACK_LICENSE.txt for its terms.
/assets/

# NOTE: public/items/*.png (Hypixel item icons) ARE committed — the Hypixel
# SkyBlock Resource Pack License permits free, Hypixel-related fan sites to use
# the assets. Keep the project free and credit Hypixel.

# Local editor / tooling config (not useful to others)
.claude/
.vscode/
.idea/

# OS + log junk
Thumbs.db
*.log
npm-debug.log*
